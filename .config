# Linux Kernel Configuration for OS Lab Module 5
CONFIG_64BIT=y
CONFIG_X86_64=y
CONFIG_BINFMT_ELF=y

# Support for RAM filesystem and initramfs boot
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y

# Hardwares and console settings
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# Filesystems & Network
CONFIG_EXT4_FS=y
CONFIG_NET=y
CONFIG_INET=y
CONFIG_FUSE_FS=y
